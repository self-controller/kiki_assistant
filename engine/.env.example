# Keys for `npm run smoke -w engine` only: the Kiki app itself takes keys in Settings › Models.
# Copy this file to .env and fill in the ones you want to check.

# https://platform.claude.com/settings/keys (smoke without --plan)
ANTHROPIC_API_KEY=
# https://aistudio.google.com/apikey (--provider google)
GEMINI_API_KEY=
# https://platform.openai.com/api-keys (--provider openai without --plan)
OPENAI_API_KEY=
# For --provider compatible against a hosted service (local servers like Ollama need none).
COMPATIBLE_API_KEY=
