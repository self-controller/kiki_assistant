{
  "name": "kiki-desktop",
  "productName": "Kiki",
  "version": "0.2.0",
  "description": "Highlight text anywhere and ask Kiki about it",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "author": "Kiki",
  "homepage": "https://github.com/self-controller/kiki_assistant",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "test": "vitest run"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@kiki/engine": "*",
    "@kiki/shared": "*",
    "dompurify": "^3.4.16",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eventsource-parser": "^4.1.1",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "lucide": "^1.48.0",
    "marked": "^18.1.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  }
}
