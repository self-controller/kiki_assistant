# Required: your Anthropic API key (https://platform.claude.com/settings/keys).
ANTHROPIC_API_KEY=

# Where invite codes and usage are stored.
KIKI_DB_PATH=kiki.db

# 127.0.0.1 for local use; 0.0.0.0 behind a reverse proxy or in Docker.
HOST=127.0.0.1
PORT=8787

# Claude settings. Effort: low | medium | high | xhigh | max (low keeps answers quick).
KIKI_MODEL=claude-opus-5-5
KIKI_EFFORT=low
KIKI_MAX_SEARCHES=3
# Set to "off" to disable server-side refusal fallback (fallbacks: "default").
KIKI_FALLBACKS=default
# Effort for questions asked with the Think toggle on.
KIKI_THINK_EFFORT=high
# Pages Claude may fetch and read per answer (shown as "Reading …" in the popup). 0 turns it off.
KIKI_MAX_FETCHES=2

# Optional: voice questions. Any OpenAI-compatible /audio/transcriptions endpoint works,
# e.g. https://api.openai.com/v1 with gpt-4o-mini-transcribe, or https://api.groq.com/openai/v1
# with whisper-large-v3-turbo. Leave the URL empty to hide the mic button.
KIKI_STT_URL=
KIKI_STT_KEY=
KIKI_STT_MODEL=
